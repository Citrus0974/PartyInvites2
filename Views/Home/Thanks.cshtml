@model GuestResponse
@{
    Layout = null;
}


<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>Thanks</title>
    </head>
    <body>
        <h1>Thank you, @Model.Name!</h1>
    @if (Model.WillAttend == true)
    {
        @:<p>you accepted invite</p>
    } else
    {
        @:<p>you didn't accept, but we will remember that you wanted to!</p>
    }
    <p>Click <a asp-action="ListResponses">here</a> to see other participants</p>
    </body>
</html>